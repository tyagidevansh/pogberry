export fun getF1Nodes(id) {
  if (id == 0) return nodes_suzuka;
  if (id == 1) return nodes_spa;
  if (id == 2) return nodes_monza;
  if (id == 3) return nodes_monaco;
  if (id >= 4 and id < 4 + len(customTracks)) {
    return customTracks[id - 4]["nodes"];
  }
  return nodes_monaco;
}

export fun getTrackWorldPoint(id, s) {
  let nodes = getF1Nodes(id);
  let N = len(nodes);
  let lapLen = getF1Length(id);
  let normS = s - math.floor(s / lapLen) * lapLen;
  let u = (normS / lapLen) * N;
  let i = math.floor(u);
  let t = u - i;

  let i0 = (i - 1 + N) % N;
  let i1 = i % N;
  let i2 = (i + 1) % N;
  let i3 = (i + 2) % N;

  let p0 = nodes[i0];
  let p1 = nodes[i1];
  let p2 = nodes[i2];
  let p3 = nodes[i3];

  let t2 = t * t;
  let t3 = t2 * t;

  let x = 0.5 * (2.0 * p1[0] + (-p0[0] + p2[0]) * t + (2.0*p0[0] - 5.0*p1[0] + 4.0*p2[0] - p3[0]) * t2 + (-p0[0] + 3.0*p1[0] - 3.0*p2[0] + p3[0]) * t3);
  let z = 0.5 * (2.0 * p1[1] + (-p0[1] + p2[1]) * t + (2.0*p0[1] - 5.0*p1[1] + 4.0*p2[1] - p3[1]) * t2 + (-p0[1] + 3.0*p1[1] - 3.0*p2[1] + p3[1]) * t3);
  return [x, z];
}

export fun getTrackTangent(id, s) {
  let nodes = getF1Nodes(id);
  let N = len(nodes);
  let lapLen = getF1Length(id);
  let normS = s - math.floor(s / lapLen) * lapLen;
  let u = (normS / lapLen) * N;
  let i = math.floor(u);
  let t = u - i;

  let i0 = (i - 1 + N) % N;
  let i1 = i % N;
  let i2 = (i + 1) % N;
  let i3 = (i + 2) % N;

  let p0 = nodes[i0];
  let p1 = nodes[i1];
  let p2 = nodes[i2];
  let p3 = nodes[i3];

  let t2 = t * t;

  let dx = 0.5 * ((-p0[0] + p2[0]) + 2.0 * (2.0*p0[0] - 5.0*p1[0] + 4.0*p2[0] - p3[0]) * t + 3.0 * (-p0[0] + 3.0*p1[0] - 3.0*p2[0] + p3[0]) * t2);
  let dz = 0.5 * ((-p0[1] + p2[1]) + 2.0 * (2.0*p0[1] - 5.0*p1[1] + 4.0*p2[1] - p3[1]) * t + 3.0 * (-p0[1] + 3.0*p1[1] - 3.0*p2[1] + p3[1]) * t2);
  return [dx, dz];
}

export fun getTrackHeading(id, s) {
  let nodes = getF1Nodes(id);
  let N = len(nodes);
  let lapLen = getF1Length(id);
  let normS = s - math.floor(s / lapLen) * lapLen;
  let u = (normS / lapLen) * N;
  let i = math.floor(u);
  let t = u - i;

  let i0 = (i - 1 + N) % N;
  let i1 = i % N;
  let i2 = (i + 1) % N;
  let i3 = (i + 2) % N;

  let p0 = nodes[i0];
  let p1 = nodes[i1];
  let p2 = nodes[i2];
  let p3 = nodes[i3];

  let t2 = t * t;

  let dx = 0.5 * ((-p0[0] + p2[0]) + 2.0 * (2.0*p0[0] - 5.0*p1[0] + 4.0*p2[0] - p3[0]) * t + 3.0 * (-p0[0] + 3.0*p1[0] - 3.0*p2[0] + p3[0]) * t2);
  let dz = 0.5 * ((-p0[1] + p2[1]) + 2.0 * (2.0*p0[1] - 5.0*p1[1] + 4.0*p2[1] - p3[1]) * t + 3.0 * (-p0[1] + 3.0*p1[1] - 3.0*p2[1] + p3[1]) * t2);
  return math.atan2(dx, dz);
}

export fun getTrackCurvature(id, s) {
  let sampleDist = 14.0;
  let h1 = getTrackHeading(id, s - sampleDist);
  let h2 = getTrackHeading(id, s + sampleDist);
  let dh = h2 - h1;
  let PI = 3.14159265;
  let TWO_PI = 6.2831853;
  while (dh > PI) dh = dh - TWO_PI;
  while (dh < -PI) dh = dh + TWO_PI;
  return dh / (sampleDist * 2.0);
}
