{
  "name": "pogberry",
  "scopeName": "source.pb",
  "patterns": [
    {
      "match": "\\b(let|fun|if|else|while|for|return|print|class|super|this|and|or|break|continue|use|as|export|switch|case|default|try|catch|throw|finally)\\b",
      "name": "keyword.control.pogberry"
    },
    {
      "match": "\\b(true|false|nil)\\b",
      "name": "constant.language.pogberry"
    },
    {
      "match": "\"(?:\\\\.|[^\"])*\"",
      "name": "string.quoted.double.pogberry"
    },
    {
      "match": "'(?:\\\\.|[^'])*'",
      "name": "string.quoted.single.pogberry"
    },
    {
      "match": "//.*$",
      "name": "comment.line.double-slash.pogberry"
    },
    {
      "match": "\\b([0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?|0x[0-9a-fA-F]+)\\b",
      "name": "constant.numeric.pogberry"
    }
  ]
}
